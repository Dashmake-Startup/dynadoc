{
  "name": "dynadoc",
  "version": "1.0.0",
  "description": "A dynamic document processor (An Electron application with Svelte and TypeScript)",
  "main": "./out/main/index.js",
  "author": "Dashmake Inc.",
  "homepage": "https://dashmake.com",
  "scripts": {
    "format": "prettier --plugin prettier-plugin-svelte --write .",
    "lint": "eslint \"**/*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,svelte}\" --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "typecheck": "npm run typecheck:node && npm run svelte-check",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "build:no-check": "electron-vite build",
    "build:electron": "electron-vite build",
    "build:web": "NODE_OPTIONS='--max-old-space-size=8192' vite build --config web.vite.config.mts",
    "build:mobile": "vite build --config capacitor.vite.config.mts && npx cap copy",
    "dev:web": "vite --config web.vite.config.mts",
    "stub-bridge": "node tools/stub-bridge/server.mjs",
    "dev:web:stub": "VITE_API_URL=http://localhost:7070 vite --config web.vite.config.mts",
    "dev:web:server": "ts-node --esm server/app.ts",
    "build:unpack": "npm run build:no-check && electron-builder --dir",
    "build:win": "npm run build:no-check && electron-builder --win",
    "build:mac": "NODE_OPTIONS='--max-old-space-size=8192' npm run build:no-check && electron-builder --mac",
    "WORKINGbuild:mac": "NODE_OPTIONS='--max-old-space-size=8192' npm run build:no-check && electron-builder --mac dmg --publish never --config.directories.output=/tmp/ddoc-build-test",
    "build:linux1": "npm run build:no-check && electron-builder --linux",
    "build:linux": "cross-env NODE_OPTIONS=--max-old-space-size=16192 npm i && npm run build:no-check && electron-builder --linux",
    "build": "npm run typecheck && electron-vite build",
    "build:capacitor": "vite build --config capacitor.vite.config.mts",
    "postinstall": "electron-rebuild electron-builder install-app-deps",
    "2postinstall2": "electron-rebuild",
    "2build:unpack": "npm run build && electron-builder --dir",
    "2build:win": "npm run build && electron-builder --win",
    "2build:mac": "npm run build && electron-builder --mac",
    "2build:linux": "npm run build && electron-builder --linux",
    "fluent:build": "ts-node src/renderer/src/components/common/react/build-fluent.mjs && vite build --config vite.fluent.config.mts",
    "2fluent:buildOld": "ts-node src/preload/build-fluent.mjs && vite build --config vite.fluent.config.mts",
    "check:cycles": "node scripts/check-cycles.mjs",
    "test:e2e:open-timing": "node tests/e2e/open-timing.test.mjs",
    "test:smoke:preload": "node tests/smoke/preload-bridge.test.mjs",
    "test:smoke:fs-policy": "node tests/smoke/fs-path-policy.test.mjs",
    "test:smoke:asset-protocol": "node tests/smoke/asset-protocol.test.mjs",
    "check:file-urls": "node scripts/find-file-url-sites.mjs",
    "ci:check": "npm run check:cycles && npm run typecheck",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,cjs,mjs,ts,tsx,cts,mts,svelte}": [
      "prettier --plugin prettier-plugin-svelte --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
