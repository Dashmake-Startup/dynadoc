# Dynadoc environment variables
# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# API endpoint for the backend
# Default (prod): https://api.dynadoc.dashmake.com
# Local backend:  http://localhost:7070
VITE_API_URL=https://api.dynadoc.dashmake.com

# IPC WebSocket URL override — leave empty to use the default
VITE_IPC_WS_URL=

# Speech-to-text WebSocket endpoint used by the meeting transcription worker.
# Leave empty to disable transcription; set it at build time to enable it.
VITE_TRANSCRIBE_WS_URL=
